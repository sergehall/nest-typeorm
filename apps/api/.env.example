# Runtime
NODE_ENV=development
PORT=5005
WEB_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://nestlab_runtime:change-me@localhost:5432/nestlab
# MIGRATION_DATABASE_URL is supplied only to migration commands, never to the API process.
# MIGRATION_DATABASE_URL=postgresql://nestlab_migrator:change-me@localhost:5432/nestlab
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Heroku Postgres requires TLS. For a local connection to a classic Heroku database whose
# certificate chain is not available to Node.js, use the following compatibility settings:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
TYPEORM_SYNCHRONIZE=false

# Rate limiting (milliseconds)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Protected Viewer and Admin API documentation.
SWAGGER_ENABLED=true
SWAGGER_VIEWER_USERNAME=viewer
SWAGGER_VIEWER_PASSWORD_HASH='$argon2id$replace-with-generated-viewer-hash'
SWAGGER_ADMIN_USERNAME=admin
SWAGGER_ADMIN_PASSWORD_HASH='$argon2id$replace-with-generated-admin-hash'
SWAGGER_SESSION_SECRET=replace-with-at-least-32-random-bytes-encoded-as-base64url
SWAGGER_SESSION_TTL_SECONDS=1200

# The remaining application/provider secrets are intentionally omitted.
# Copy the names from validation-schema.configuration.ts and supply them
# through your deployment platform's secret manager, never through Git.

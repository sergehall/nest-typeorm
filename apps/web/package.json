{
  "name": "@nest-typeorm/web",
  "version": "0.1.0",
  "description": "Next.js frontend for the Nest TypeORM educational platform.",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:no-open": "node ./scripts/dev.mjs --no-open",
    "build": "next build --webpack && node ./scripts/prepare-standalone.mjs",
    "start": "node ./.next/standalone/apps/web/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  }
}

{
  "name": "nest-typeorm-platform",
  "version": "1.36.0",
  "description": "Educational full-stack platform with NestJS and Next.js applications.",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": "24.18.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "runtime:check": "node -e \"const expected = '24.18.0'; const actual = process.versions.node; if (actual !== expected) { console.error('Expected Node.js ' + expected + ', got ' + actual); process.exit(1); }\"",
    "dev:api": "yarn workspace @nest-typeorm/api start:dev",
    "dev:web": "yarn workspace @nest-typeorm/web dev",
    "dev:web:no-open": "yarn workspace @nest-typeorm/web dev:no-open",
    "build": "yarn build:api && yarn build:web",
    "build:api": "yarn workspace @nest-typeorm/api build",
    "build:web": "yarn workspace @nest-typeorm/web build",
    "start:api": "yarn workspace @nest-typeorm/api start:prod",
    "start:web": "yarn workspace @nest-typeorm/web start",
    "typecheck": "yarn typecheck:api && yarn typecheck:web",
    "typecheck:api": "yarn workspace @nest-typeorm/api typecheck",
    "typecheck:web": "yarn workspace @nest-typeorm/web typecheck",
    "lint": "yarn lint:api && yarn lint:web",
    "lint:api": "yarn workspace @nest-typeorm/api lint",
    "lint:web": "yarn workspace @nest-typeorm/web lint",
    "lint:fix": "yarn lint:fix:api && yarn lint:fix:web",
    "lint:fix:api": "yarn workspace @nest-typeorm/api lint:fix",
    "lint:fix:web": "yarn workspace @nest-typeorm/web lint:fix",
    "test": "yarn workspace @nest-typeorm/api test",
    "test:e2e": "yarn workspace @nest-typeorm/api test:e2e",
    "test:cov": "yarn workspace @nest-typeorm/api test:cov",
    "swagger:credentials": "yarn workspace @nest-typeorm/api swagger:credentials",
    "language:check": "node ./scripts/check-english-language.mjs",
    "format": "prettier . --write",
    "format:api": "yarn workspace @nest-typeorm/api format",
    "format:web": "yarn workspace @nest-typeorm/web format",
    "format:check": "prettier . --check",
    "verify": "yarn language:check && yarn typecheck && yarn lint && yarn test && yarn build"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
